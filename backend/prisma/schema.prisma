// Prisma schema for the Car Dealership Inventory System.
// The connection URL lives in prisma.config.ts (Prisma 7+), not here.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// Access level. Everyone registers as USER; ADMIN accounts are created by the seed script.
enum Role {
  USER
  ADMIN
}

/// Fixed set of body styles a vehicle can be listed under.
enum Category {
  SEDAN
  SUV
  HATCHBACK
  TRUCK
  CONVERTIBLE
  VAN
  EV
}

model User {
  id           String     @id @default(cuid())
  /// Display name shown in the UI (e.g. "Hi, Arnav"). Login is by email; names need not be unique.
  name         String
  email        String     @unique
  passwordHash String
  role         Role       @default(USER)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  purchases    Purchase[]

  @@map("users")
}

model Vehicle {
  id         String     @id @default(cuid())
  make       String
  model      String
  category   Category
  year       Int
  color      String
  /// Price in integer cents (e.g. 2499900 = $24,999.00) to avoid floating-point errors.
  priceCents Int
  /// Units in stock. A CHECK constraint in the migration keeps it >= 0.
  quantity   Int        @default(0)
  /// Photo of this exact make, model and year. Required: every listing must show the car.
  imageUrl   String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  purchases  Purchase[]

  @@index([make])
  @@index([category])
  @@map("vehicles")
}

/// One completed purchase. The vehicle's details and the unit price are copied
/// at the time of sale, so the order history stays accurate even if the listing
/// is later edited or deleted.
model Purchase {
  id             String   @id @default(cuid())
  buyerId        String
  buyer          User     @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  /// Null once the listing has been deleted; the snapshot below still describes the car.
  vehicleId      String?
  vehicle        Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  quantity       Int
  unitPriceCents Int
  make           String
  model          String
  category       Category
  year           Int
  color          String
  imageUrl       String
  createdAt      DateTime @default(now())

  @@index([buyerId, createdAt])
  @@map("purchases")
}
