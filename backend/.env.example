# Copy this file to backend/.env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=4000

# Local PostgreSQL databases (see README for setup).
DATABASE_URL="postgresql://dealership:CHANGE_ME@localhost:5432/car_dealership"
# Separate database used only by the integration test suite.
TEST_DATABASE_URL="postgresql://dealership:CHANGE_ME@localhost:5432/car_dealership_test"

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=1h

# Admin account created by `npm run db:seed -w backend` (dev/test only, never production).
SEED_ADMIN_NAME="Dealership Admin"
SEED_ADMIN_EMAIL=admin@dealership.local
SEED_ADMIN_PASSWORD=CHANGE_ME_AT_LEAST_8_CHARS

# Optional: bcrypt cost factor for password hashing (default 12).
# BCRYPT_ROUNDS=12
